        {
            "parameters": {
                "resource": "image",
                "operation": "analyze",
                "modelId": {
                    "__rl": true,
                    "value": "gpt-4o",
                    "mode": "list"
                },
                "prompt": "Wyekstrahuj dane z polskiego wyciągu bankowego w formacie JSON:\n{\n  \"document_info\": {\n    \"bank_name\": \"string\",\n    \"account_holder\": \"string\",\n    \"account_number\": \"PL...\",\n    \"statement_period\": {\"from\": \"YYYY-MM-DD\", \"to\": \"YYYY-MM-DD\"},\n    \"currency\": \"PLN\"\n  },\n  \"balances\": {\n    \"opening_balance\": 0.00,\n    \"closing_balance\": 0.00,\n    \"total_income\": 0.00,\n    \"total_expense\": 0.00\n  },\n  \"transactions\": [\n    {\n      \"date\": \"YYYY-MM-DD\",\n      \"description\": \"string\",\n      \"amount\": -150.50,\n      \"type\": \"debit|credit\",\n      \"balance_after\": 5000.00\n    }\n  ],\n  \"metadata\": {\n    \"total_transactions\": 0,\n    \"confidence_score\": 0.95\n  }\n}\n\nZasady:\n- Daty w formacie YYYY-MM-DD\n- Kwoty debetowe jako ujemne liczby\n- Kwoty kredytowe jako dodatnie liczby\n- Zwróć TYLKO JSON bez markdown",
                "options": {
                    "temperature": 0.1,
                    "maxTokens": 4000
                }
            },
            "id": "ai-extract",
            "name": "GPT4o Vision Extract",
            "type": "@n8n/n8n-nodes-langchain.openAi",
            "typeVersion": 1.8,
            "position": [
                1120,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "// Parse AI response and validate\nconst aiResponse = $input.item.json.message?.content || '{}';\nlet data;\n\ntry {\n  // Remove markdown code blocks if present\n  const cleanJson = aiResponse.replace(/```json\\n?|```/g, '').trim();\n  data = JSON.parse(cleanJson);\n  \n  // Basic validation\n  const confidence = data.metadata?.confidence_score || 0;\n  const hasTransactions = (data.transactions?.length || 0) > 0;\n  \n  // Calculate balance check\n  const openingBalance = data.balances?.opening_balance || 0;\n  const closingBalance = data.balances?.closing_balance || 0;\n  const transactionSum = (data.transactions || []).reduce((sum, t) => sum + (t.amount || 0), 0);\n  const balanceMatch = Math.abs((openingBalance + transactionSum) - closingBalance) < 0.01;\n  \n  return {\n    json: {\n      ...data,\n      validation: {\n        is_valid: confidence > 0.85 && hasTransactions && balanceMatch,\n        confidence: confidence,\n        balance_check: balanceMatch,\n        has_data: hasTransactions,\n        errors: !balanceMatch ? ['Saldo nie zgadza się'] : []\n      }\n    }\n  };\n} catch (error) {\n  return {\n    json: {\n      validation: {\n        is_valid: false,\n        confidence: 0,\n        errors: [`Parse error: ${error.message}`]\n      }\n    }\n  };\n}"
            },
            "id": "validate-data",
            "name": "Validate and Parse",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1340,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": ""
                    },
                    "conditions": [
                        {
